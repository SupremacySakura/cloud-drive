# Docker only. pnpm dev uses .env.development instead.
# Existing installations: preserve project/container/network/volume names.
COMPOSE_PROJECT_NAME=zhixu

# profiles: infra / backend / frontend / full
COMPOSE_PROFILES=full

# image tags
MYSQL_IMAGE=mysql:8.4

# container names
MYSQL_CONTAINER_NAME=zhixu-mysql
BACKEND_CONTAINER_NAME=zhixu-backend
FRONTEND_CONTAINER_NAME=zhixu-frontend

# host ports
MYSQL_PORT=3307
BACKEND_HOST_PORT=9001
FRONTEND_PORT=8080

# backend container runtime port (keep this aligned with frontend's internal upstream: backend:9000)
BACKEND_CONTAINER_PORT=9000
BACKEND_UPSTREAM_HOST=backend

# local bind paths
MYSQL_DATA_DIR=./data/mysql
MYSQL_INIT_DIR=./ops/mysql/init
MYSQL_IMPORT_DIR=./ops/mysql/import

# mysql init
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=zhixu
MYSQL_INITDB_SKIP_TZINFO=1

# backend runtime
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password
DB_NAME=zhixu
JWT_SECRET=your_jwt_secret_key
CHUNK_STORAGE_PATH=/app/data
FILE_STORAGE_PATH=/app/data

# compose resource names
NETWORK_NAME=zhixu-network
MYSQL_VOLUME_NAME=mysql-data
BACKEND_VOLUME_NAME=backend-data
