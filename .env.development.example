# Local development only; copied to .env.development.
PORT=9000
DEV_FRONTEND_PORT=5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Set this to your local MySQL account password.
DB_PASSWORD=your_local_mysql_password
DB_NAME=zhixu
JWT_SECRET=local-development-only-change-for-production
APP_ENV=development
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Paths are relative to apps/zhixu-backend.
CHUNK_STORAGE_PATH=../../data/dev/files
FILE_STORAGE_PATH=../../data/dev/files
